<?xml version="1.0" encoding="utf-8"?>
<!-- The resource shrinker only honors tools:keep from res/raw/keep.xml. Play services reads the
     capability array at runtime (no code reference), so without this it's stripped from release
     builds and the phone/watch can no longer find each other. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@array/android_wear_capabilities" />

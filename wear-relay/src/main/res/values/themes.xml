<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- No platform action bar: the status screen draws its own title and handles edge-to-edge insets. -->
    <style name="Theme.Relay" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
